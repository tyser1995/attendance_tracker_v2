// Prisma's datasource `provider` is a static string baked in at `prisma generate`
// time — only `url` can come from an env var. This app runs SQLite locally
// (`DATABASE_URL="file:..."`) and Postgres in production (Supabase), so the schema's
// provider has to be rewritten to match DATABASE_URL before each generate — see
// scripts/prisma-provider.js.
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(STAFF)

  // Phase 2 — RFID/barcode and face-recognition login, not used yet.
  cardId         String? @unique
  faceDescriptor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Course {
  id         String @id @default(cuid())
  courseCode String @unique
  courseName String
  yearLevel  String @default("")

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

model Student {
  id         String  @id @default(cuid())
  idNumber   String
  firstName  String
  lastName   String
  middleName String?
  dob        String?
  sex        String?
  isDeleted  Boolean @default(false)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([idNumber])
  @@map("students")
}

// status: 1 = AM Time In, 2 = AM Time Out, 3 = PM Time In, 4 = PM Time Out.
// Each student ID scan advances to the next status for the current day.
model Attendance {
  id          String  @id @default(cuid())
  idNumber    String
  name        String  @default("")
  timeIn      String?
  timeOut     String?
  createdDate String
  status      Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdDate])
  @@index([idNumber])
  @@map("attendances")
}

model IdPattern {
  id      String @id @default(cuid())
  pattern String @unique
  regex   String
  status  String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("id_patterns")
}

// What signed-in users do: pages opened, controls clicked, sign-ins, and backup restores.
// Kept for 90 days and left out of backups.
model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  username  String?
  role      String?
  action    String
  path      String?
  target    String?

  @@index([createdAt])
  @@index([username])
  @@map("activity_logs")
}

// Errors from the server, browsers, and background jobs. Kept for 90 days and left out of backups.
model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  source    String
  message   String
  stack     String?
  digest    String?
  path      String?
  username  String?

  @@index([createdAt])
  @@map("error_logs")
}

// Uploaded logo and browser icon. Kept out of backups, so restoring doesn't change them.
model BrandingAsset {
  kind      String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  @@map("branding_assets")
}

// Single-row app settings.
model Settings {
  id          Int    @id @default(1)
  initialPage String @default("login")
  appName     String @default("Attendance Tracker")

  // Scheduled backups. Frequency: off, every24h, daily, weekly, monthly.
  backupFrequency String    @default("off")
  backupTime      String    @default("18:00")
  backupWeekday   Int       @default(1)
  backupMonthDay  Int       @default(1)
  backupFolder    String?
  nextBackupAt    DateTime?
  lastBackupAt    DateTime?
  lastBackupError String?

  @@map("settings")
}
