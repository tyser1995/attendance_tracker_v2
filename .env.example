# Database (Prisma)
# Local dev (SQLite) — no server needed:
DATABASE_URL="file:./prisma/dev.db"
# Production (Postgres via Supabase) — replace with your connection string:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Auth (next-auth)
AUTH_SECRET=replace_with_a_random_32_byte_secret
# AUTH_URL is normally not needed — next-auth v5 infers it from the request.
# Set it explicitly only if you deploy behind a reverse proxy that strips/rewrites headers.
# AUTH_URL=https://your-domain.example

# App
NEXT_PUBLIC_APP_NAME=Attendance Tracker
